#!/usr/bin/env bash
TASKS_FILE="$HOME/.config/fastfetch/tasks.txt"

if [ ! -s "$TASKS_FILE" ]; then
    echo "No tasks found in ~/.config/fastfetch/tasks.txt"
    exit 0
fi

SELECTED=$(fzf --height=40% --layout=reverse --border=rounded --header="=== EDIT Task ===" --prompt="Select task to edit > " < "$TASKS_FILE")
if [ -n "$SELECTED" ]; then
    read -p "Enter new task description: " NEW_TEXT
    if [ -n "$NEW_TEXT" ]; then
        python3 "$HOME/.local/share/bin/manage_tasks.py" edit_text "$SELECTED" "$NEW_TEXT"
        fastfetch
    fi
fi
